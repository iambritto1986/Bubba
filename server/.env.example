# Copy to .env and fill in. Never commit .env.
PORT=8787

# Clerk (dashboard.clerk.com -> your app -> API keys)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Render Postgres: use the EXTERNAL connection string when running locally,
# the INTERNAL one is wired automatically on Render via render.yaml.
DATABASE_URL=postgres://user:pass@host:5432/bubba

# Gemini (aistudio.google.com -> Get API key)
GEMINI_API_KEY=xxx
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated extra origins allowed by CORS (dev + Tauri are built in)
EXTRA_ORIGINS=
